<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>プロフィール - やることリスト</title>
    <%- include('head') %>
    <link rel="stylesheet" href="/css/profile.css">
    <link rel="stylesheet" href="/css/auth-base.css">
</head>
<body>
    <div class="card">
        <div class="header">
            <h1>プロフィール</h1>
            <p>所属部署を設定・変更できます</p>
        </div>

        <div class="user-info">
            <div>名前：<strong><%= currentUser.username || currentUser.email.split('@')[0] %></strong></div>
            <div>メール：<strong><%= currentUser.email %></strong></div>
        </div>

        <% if (error) { %>
            <div class="alert-error">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"></circle>
                    <line x1="12" y1="8" x2="12" y2="12"></line>
                    <line x1="12" y1="16" x2="12.01" y2="16"></line>
                </svg>
                <span><%= error %></span>
            </div>
        <% } %>

        <% if (success) { %>
            <div class="alert-success">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
                <span><%= success %></span>
            </div>
        <% } %>

        <form action="/profile" method="POST">
            <div class="form-group">
                <label class="group-label">所属部署 <span style="font-weight:normal; color: var(--text-muted); font-size:0.75rem;">(複数選択可)</span></label>

                <% if (allDepartments.length === 0) { %>
                    <p class="no-dept">現在登録されている部署がありません。</p>
                <% } else { %>
                    <div class="dept-grid">
                        <% allDepartments.forEach(dept => { %>
                            <% const isChecked = userDeptIds.includes(dept.id); %>
                            <label class="dept-checkbox <%= isChecked ? 'checked' : '' %>">
                                <input
                                    type="checkbox"
                                    name="departmentIds"
                                    value="<%= dept.id %>"
                                    <%= isChecked ? 'checked' : '' %>
                                    onchange="this.closest('.dept-checkbox').classList.toggle('checked', this.checked)"
                                >
                                <%= dept.name %>
                            </label>
                        <% }) %>
                    </div>
                <% } %>
            </div>

            <button type="submit" class="btn-submit">保存する</button>
        </form>

        <div class="footer-links">
            <a href="/todos">← Todo一覧に戻る</a>
        </div>
    </div>
</body>
</html>

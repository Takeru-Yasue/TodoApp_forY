<!DOCTYPE html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>やることリスト</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&family=Noto+Sans+JP:wght@400;600;700&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/css/index.css" />
  </head>
  <body>
    <div class="container">
      <header>
        <div
          style="
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 0.5rem;
          "
        >
          <h1 style="margin: 0">やることリスト</h1>
          <div style="display: flex; align-items: center; gap: 0.75rem">
            <% if (typeof currentUser !== 'undefined' && currentUser) { %>
            <div
              style="
                display: flex;
                flex-direction: column;
                align-items: flex-end;
              "
            >
              <span style="font-size: 0.875rem; color: var(--text-muted)">
                ようこそ、<strong
                  ><%= currentUser.username || currentUser.email.split('@')[0] %></strong
                >
                さん
              </span>
              <% if (currentUser.departments && currentUser.departments.length >
              0) { %>
              <span
                style="
                  font-size: 0.78rem;
                  color: var(--primary);
                  font-weight: 600;
                "
              >
                所属: <%= currentUser.departments.map(d => d.name).join(', ') %>
              </span>
              <% } else { %>
              <span
                style="
                  font-size: 0.78rem;
                  color: var(--text-muted);
                  font-style: italic;
                "
              >
                所属: なし
              </span>
              <% } %>
            </div>
            <a
              href="/profile"
              style="
                text-decoration: none;
                font-size: 0.875rem;
                color: var(--text-muted);
                font-weight: 600;
                padding: 0.4rem 0.8rem;
                border: 1px solid var(--border);
                border-radius: 8px;
                background: #fff;
                transition: all 0.15s ease;
              "
              >👤 プロフィール</a
            >
            <a
              href="/departments"
              style="
                text-decoration: none;
                font-size: 0.875rem;
                color: var(--text-muted);
                font-weight: 600;
                padding: 0.4rem 0.8rem;
                border: 1px solid var(--border);
                border-radius: 8px;
                background: #fff;
                transition: all 0.15s ease;
              "
              >🏢 部署一覧</a
            >
            <a
              href="/logout"
              style="
                text-decoration: none;
                font-size: 0.875rem;
                color: var(--danger);
                font-weight: 600;
                padding: 0.4rem 0.8rem;
                border: 1px solid var(--danger-border);
                border-radius: 8px;
                background: #fff;
                transition: all 0.15s ease;
              "
              >ログアウト</a
            >

            <% } else { %>
            <a
              href="/login"
              style="
                text-decoration: none;
                font-size: 0.875rem;
                color: var(--primary);
                font-weight: 600;
                padding: 0.4rem 0.8rem;
                border: 1px solid var(--primary);
                border-radius: 8px;
                transition: all 0.15s ease;
              "
              >ログイン</a
            >
            <a
              href="/register"
              style="
                text-decoration: none;
                font-size: 0.875rem;
                color: #fff;
                background-color: var(--primary);
                font-weight: 600;
                padding: 0.4rem 0.8rem;
                border-radius: 8px;
                transition: all 0.15s ease;
              "
              >新規登録</a
            >
            <% } %>
          </div>
        </div>
      </header>

      <!-- 上部フィルターアクションバー -->
      <div
        style="
          display: flex;
          justify-content: space-between;
          align-items: center;
          margin-bottom: 0.75rem;
        "
      >
        <span
          id="filterCount"
          style="font-size: 0.85rem; font-weight: 600; color: var(--text-muted)"
        ></span>
        <button
          type="button"
          class="filter-btn"
          id="filterToggleBtn"
          onclick="toggleFilterDrawer()"
        >
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <line x1="4" y1="6" x2="20" y2="6"></line>
            <line x1="8" y1="12" x2="20" y2="12"></line>
            <line x1="12" y1="18" x2="20" y2="18"></line>
          </svg>
          <span>フィルター</span>
          <span
            id="activeFilterDot"
            class="active-dot"
            style="display: none"
          ></span>
        </button>
      </div>

      <!-- 右側スライドフィルタードロワー (Hamburger Side Sheet) -->
      <div
        class="filter-drawer-backdrop"
        id="filterBackdrop"
        onclick="closeFilterDrawer()"
      ></div>
      <div class="filter-drawer" id="filterDrawer">
        <div class="drawer-header">
          <h2>
            <svg
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3" />
            </svg>
            絞り込みフィルター
          </h2>
          <button
            type="button"
            class="close-drawer-btn"
            onclick="closeFilterDrawer()"
            title="閉じる"
          >
            ✕
          </button>
        </div>

        <div style="flex: 1; overflow-y: auto">
          <!-- 1. 部署フィルター -->
          <div class="filter-field">
            <label for="filterDepartment">🏢 部署・個人で絞り込み</label>
            <select
              id="filterDepartment"
              onchange="applyFilters()"
              style="
                width: 100%;
                padding: 0.6rem 0.75rem;
                border-radius: 8px;
                border: 1px solid var(--border);
                font-size: 0.9rem;
                background: #f8fafc;
                outline: none;
              "
            >
              <option value="all">すべての部署・個人</option>
              <option value="personal">👤 個人タスクのみ</option>
              <% if (typeof currentUser !== 'undefined' && currentUser && currentUser.departments) { %>
              <% currentUser.departments.forEach(dept => { %>
              <option value="<%= dept.id %>">🏢 <%= dept.name %></option>
              <% }) %>
              <% } %>
            </select>
          </div>

          <!-- 2. ステータスフィルター -->
          <div class="filter-field">
            <label for="filterStatus">⏰ ステータスで絞り込み</label>
            <select
              id="filterStatus"
              onchange="applyFilters()"
              style="
                width: 100%;
                padding: 0.6rem 0.75rem;
                border-radius: 8px;
                border: 1px solid var(--border);
                font-size: 0.9rem;
                background: #f8fafc;
                outline: none;
              "
            >
              <option value="all">すべての状態</option>
              <option value="overdue">🚨 期限切れ</option>
              <option value="approaching">⏰ 期限間近</option>
              <option value="normal">✅ 通常</option>
            </select>
          </div>
        </div>

        <div
          style="
            padding-top: 1rem;
            border-top: 1px solid var(--border);
            display: flex;
            gap: 0.5rem;
          "
        >
          <button
            type="button"
            onclick="resetFilters()"
            style="
              flex: 1;
              padding: 0.6rem;
              border: 1px solid var(--border);
              background: #f1f5f9;
              color: var(--text-muted);
              border-radius: 8px;
              font-weight: 600;
              cursor: pointer;
            "
          >
            リセット
          </button>
          <button
            type="button"
            onclick="closeFilterDrawer()"
            style="
              flex: 1;
              padding: 0.6rem;
              border: none;
              background: var(--primary);
              color: #fff;
              border-radius: 8px;
              font-weight: 600;
              cursor: pointer;
            "
          >
            完了
          </button>
        </div>
      </div>

      <ul class="todo-list" id="todoList">
        <% if (todos.length === 0) { %>
        <div class="empty-state">
          <% if (typeof currentUser !== 'undefined' && currentUser) { %>
          Todoはありません。新しいタスクを追加しましょう。 <% } else { %>
          現在表示できるTodoはありません。<a
            href="/login"
            style="color: var(--primary); font-weight: 600"
            >ログイン</a
          >
          してTodoを管理しましょう。
          <% } %>
        </div>
        <% } %>
        <% const now = new Date(); const tomorrow = new Date(now.getTime() + 24
        * 60 * 60 * 1000); todos.forEach(todo => { const dueDate = new
        Date(todo.dueDate); const isOverdue = dueDate < now; const isApproaching
        = !isOverdue && dueDate < tomorrow; let statusClass = ''; let statusKey
        = 'normal'; if (isOverdue) { statusClass = 'overdue'; statusKey =
        'overdue'; } else if (isApproaching) { statusClass = 'approaching';
        statusKey = 'approaching'; } %>
        <li
          class="todo-item <%= statusClass %>"
          data-department-id="<%= todo.departmentId ? todo.departmentId : 'personal' %>"
          data-status="<%= statusKey %>"
          data-period="<%= todo.period || '' %>"
        >
          <div class="todo-info">
            <div class="todo-header">
              <span class="todo-title"><%= todo.title %></span>
              <% if (isOverdue) { %>
              <span class="overdue-label">期限切れ</span>
              <% } else if (isApproaching) { %>
              <span class="approaching-label">期限間近</span>
              <% } %>
              <% if (todo.period && todo.period !== '') { %>
              <span class="period-badge"><%= todo.period %></span>
              <% } %>
              <% if (todo.department) { %>
              <span
                class="period-badge"
                style="background: #e0e7ff; color: #3730a3; font-weight: 700"
                >🏢
                <%= todo.department.name %></span
              >
              <% } %>
            </div>
            <div class="todo-meta">
              📅 <%= new Date(todo.dueDate).toLocaleString('ja-JP', { dateStyle:
              'medium', timeStyle: 'short' }) %> <% if (todo.user && (typeof
              currentUser === 'undefined' || !currentUser || todo.user.id !==
              currentUser.id)) { %> · 作成者:
              <strong
                ><%= todo.user.username || todo.user.email.split('@')[0] %></strong
              >
              <% } %>
            </div>
          </div>
          <!-- /todo/:id を使用した RESTful な編集・削除 -->
          <div style="display: flex; align-items: center; gap: 0.25rem">
            <button
              type="button"
              class="complete-btn edit-btn"
              title="編集"
              style="color: #6366f1"
              data-id="<%= todo.id %>"
              data-title="<%= todo.title %>"
              data-date="<%= new Date(todo.dueDate).toISOString().split('T')[0] %>"
              data-time="<%= new Date(todo.dueDate).toTimeString().slice(0, 5) %>"
              data-period="<%= todo.period ?? '' %>"
              data-department-id="<%= todo.departmentId ?? '' %>"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M12 20h9" />
                <path
                  d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"
                />
              </svg>
            </button>
            <form
              action="/todo/<%= todo.id %>?_method=DELETE"
              method="POST"
              onsubmit="return confirm('完了しましたか？');"
            >
              <button type="submit" class="complete-btn" title="完了">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="20"
                  height="20"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="3"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
              </button>
            </form>
          </div>
        </li>
        <% }) %>
      </ul>

      <!-- Todo 編集モーダル -->
      <div
        class="filter-drawer-backdrop"
        id="editModalBackdrop"
        onclick="closeEditModal()"
      ></div>
      <div
        class="add-card"
        id="editModal"
        style="
          position: fixed;
          top: 50%;
          left: 50%;
          transform: translate(-50%, -50%);
          z-index: 1000;
          width: 90%;
          max-width: 500px;
          display: none;
          box-shadow: 0 10px 25px rgba(0, 0, 0, 0.2);
        "
      >
        <div class="add-card-header" style="cursor: default">
          <h2>Todoの編集</h2>
          <button
            type="button"
            class="close-drawer-btn"
            onclick="closeEditModal()"
          >
            ✕
          </button>
        </div>
        <div class="add-card-body" style="padding-top: 1rem">
          <form id="editForm" method="POST">
            <div class="form-group">
              <label for="editTitle">Title</label>
              <input type="text" id="editTitle" name="title" required />
            </div>
            <% if (typeof currentUser !== 'undefined' && currentUser &&
            currentUser.departments && currentUser.departments.length > 0) { %>
            <div class="form-group">
              <label for="editDepartmentId">対象部署 (共有範囲)</label>
              <select id="editDepartmentId" name="departmentId">
                <option value="">👤 自分のみ (個人タスク)</option>
                <% currentUser.departments.forEach(dept => { %>
                <option value="<%= dept.id %>">🏢 <%= dept.name %></option>
                <% }) %>
              </select>
            </div>
            <% } %>
            <div class="form-row">
              <div class="form-group" style="flex: 2">
                <label for="editDate">Date</label>
                <input type="date" id="editDate" name="date" required />
              </div>
              <div class="form-group" style="flex: 1">
                <label for="editTime">Time</label>
                <input type="time" id="editTime" name="time" required />
              </div>
            </div>
            <div class="form-group">
              <label for="editPeriod">Period</label>
              <select id="editPeriod" name="period">
                <option value="auto">✨ 自動判定（時間から計算）</option>
                <option value="none">なし</option>
                <option value="朝">朝</option>
                <option value="1">1</option>
                <option value="2">2</option>
                <option value="3">3</option>
                <option value="4">4</option>
                <option value="昼">昼</option>
                <option value="5">5</option>
                <option value="6">6</option>
                <option value="7">7</option>
                <option value="放課後">放課後</option>
              </select>
            </div>
            <div style="display: flex; gap: 0.5rem; margin-top: 1rem">
              <button
                type="button"
                onclick="closeEditModal()"
                style="
                  flex: 1;
                  padding: 0.75rem;
                  border: 1px solid var(--border);
                  background: #f1f5f9;
                  color: var(--text-muted);
                  border-radius: 8px;
                  font-weight: 600;
                  cursor: pointer;
                "
              >
                キャンセル
              </button>
              <button
                type="submit"
                class="submit-btn"
                style="flex: 1; margin-top: 0"
              >
                保存する
              </button>
            </div>
          </form>
        </div>
      </div>

      <div class="add-card" id="addCard">
        <div class="add-card-header" onclick="toggleForm()">
          <h2>New Task</h2>
          <div class="toggle-icon">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="m6 9 6 6 6-6" />
            </svg>
          </div>
        </div>
        <div class="add-card-body">
          <% if (typeof currentUser !== 'undefined' && currentUser) { %>
          <!-- /todos を使用した RESTful な追加 -->
          <form action="/todos" method="POST">
            <div class="form-group">
              <label for="title">Title</label>
              <input
                type="text"
                id="title"
                name="title"
                required
                placeholder="何をする？"
              />
            </div>
            <% if (currentUser.departments && currentUser.departments.length >
            0) { %>
            <div class="form-group">
              <label for="departmentId">対象部署 (共有範囲)</label>
              <select id="departmentId" name="departmentId">
                <option value="">👤 自分のみ (個人タスク)</option>
                <% currentUser.departments.forEach(dept => { %>
                <option value="<%= dept.id %>">🏢 <%= dept.name %></option>
                <% }) %>
              </select>
            </div>
            <% } %>
            <div class="form-row">
              <div class="form-group" style="flex: 2">
                <label for="date">Date</label>
                <input type="date" id="date" name="date" required />
              </div>
              <div class="form-group" style="flex: 1">
                <label for="time">Time</label>
                <input
                  type="time"
                  id="time"
                  name="time"
                  required
                  value="09:00"
                />
              </div>
            </div>
            <div class="form-group">
              <label for="period">Period</label>
              <select id="period" name="period">
                <option value="auto" selected>
                  ✨ 自動判定（時間から計算）
                </option>
                <option value="none">なし</option>
                <option value="朝">朝</option>
                <option value="1">1</option>
                <option value="2">2</option>
                <option value="3">3</option>
                <option value="4">4</option>
                <option value="昼">昼</option>
                <option value="5">5</option>
                <option value="6">6</option>
                <option value="7">7</option>
                <option value="放課後">放課後</option>
              </select>
            </div>
            <button type="submit" class="submit-btn">Add Todo</button>
          </form>
          <% } else { %>
          <div style="text-align: center; padding: 1.5rem 1rem">
            <p
              style="
                color: var(--text-muted);
                margin-bottom: 1rem;
                font-size: 0.95rem;
              "
            >
              タスクを追加・管理するにはログインが必要です。
            </p>
            <a
              href="/login"
              style="
                display: inline-block;
                background-color: var(--primary);
                color: #fff;
                text-decoration: none;
                padding: 0.6rem 1.25rem;
                border-radius: 8px;
                font-weight: 600;
                font-size: 0.95rem;
              "
            >
              ログインして始める
            </a>
          </div>
          <% } %>
        </div>
      </div>
    </div>

    <script src="/js/index.js"></script>
  </body>
</html>
